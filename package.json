{
  "name": "keyclack",
  "productName": "Keyclack",
  "version": "0.1.0",
  "description": "Cross-platform keystroke-sound app with live stats and a typing test.",
  "author": "Keyclack",
  "license": "MIT",
  "main": "src/main/main.js",
  "homepage": "https://github.com/ayushmgarg/keyclack",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayushmgarg/keyclack.git"
  },
  "scripts": {
    "start": "electron .",
    "gen:icons": "node scripts/gen-icons.js",
    "postinstall": "node scripts/gen-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
